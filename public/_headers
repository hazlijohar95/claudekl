# Built JS, CSS and fonts carry a content hash in their names, so a new
# build never reuses a URL: browsers can keep them for a year without asking.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Brand art keeps its name across edits: cache for a day, then revalidate.
/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
